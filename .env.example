# Choose openai (OpenAI or a compatible translation endpoint) or azure.
TRANSLATE_PROVIDER=openai
TRANSLATE_URL=wss://api.openai.com/v1/realtime/translations?model=gpt-realtime-translate
TRANSLATE_KEY=replace-with-provider-api-key
# For azure, set TRANSLATE_PROVIDER=azure and fill these instead:
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=YOUR-TRANSLATION-DEPLOYMENT
# AZURE_OPENAI_API_KEY=replace-with-azure-api-key
# Four digits required to prepare a speaker session; listeners use a separate session code.
SPEAKER_PIN=0000
# Original-language captions: audio.input.transcription model on the room language's translation channel, or off.
TRANSLATE_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# Noise reduction requested in session.update: off, near_field (phone held close) or far_field (room microphone).
# The speaker can override the translation setting per session in the app.
TRANSLATE_NOISE_REDUCTION=near_field
# Host ports published by HAProxy (container ports stay 8443 and 8080).
HTTPS_PORT=8443
HTTP_PORT=8080

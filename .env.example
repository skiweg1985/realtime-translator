TRANSLATE_URL=wss://litellm-test.simplicity.ag/v1/realtime/translations?model=azure-live-translate
TRANSLATE_KEY=replace-with-dedicated-translate-virtual-key
TRANSCRIBE_URL=wss://litellm-test.simplicity.ag/v1/realtime?model=azure-live-transcribe&intent=transcription
TRANSCRIBE_MODEL=azure-live-transcribe
# Separate key allowed to call azure-live-transcribe.
TRANSCRIBE_KEY=replace-with-transcription-virtual-key
# Noise reduction requested in session.update: off, near_field (phone held close) or far_field (room microphone).
# The LiteLLM test gateway rejects every audio.input field on the translation route, so keep translation at off.
TRANSLATE_NOISE_REDUCTION=off
TRANSCRIBE_NOISE_REDUCTION=near_field
# Host ports published by HAProxy (container ports stay 8443 and 8080).
HTTPS_PORT=8443
HTTP_PORT=8080
